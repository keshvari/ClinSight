{
  "name": "endoscopy-report-system-react",
  "description": "Modern React-based Endoscopy Report System",
  "version": "1.0.0",
  "author": "Ali Keshvari",
  "license": "BSD",
  "keywords": [
    "Rectoscopy",
    "Endoscopy",
    "Colonoscopy", 
    "Rectosigmoidoscopy",
    "Flexible Endoscopy",
    "Gastroscopy",
    "Esophagogastroduodenoscopy",
    "Esophagoscopy",
    "Esophagoscopy",
    "Report",
    "System",
    "DesktopCapture",
    "Screen Recorder",
    "WebRTC",
    "React",
    "Electron"
  ],
  "main": "public/electron.js",
  "homepage": "./",
  "scripts": {
    "start": "react-scripts start",
    "build": "react-scripts build",
    "test": "react-scripts test",
    "eject": "react-scripts eject",
    "electron": "electron .",
    "electron-dev": "ELECTRON_IS_DEV=1 electron .",
    "electron-pack": "electron-builder",
    "preelectron-pack": "npm run build",
    "build-electron": "npm run build && npm run electron-pack",
    "build-mac": "npm run build && electron-builder --mac",
    "build-win": "npm run build && electron-builder --win",
    "build-linux": "npm run build && electron-builder --linux"
  },
  "dependencies": {
    "@emotion/react": "^11.11.1",
    "@emotion/styled": "^11.11.0",
    "@mui/icons-material": "^5.14.19",
    "@mui/material": "^5.14.20",
    "@mui/x-date-pickers": "^6.18.1",
    "axios": "^1.6.2",
    "date-fns": "^2.30.0",
    "dayjs": "^1.11.10",
    "electron-is-dev": "^2.0.0",
    "html2canvas": "^1.4.1",
    "jspdf": "^2.5.1",
    "lodash": "^4.17.21",
    "moment": "^2.29.4",
    "moment-jalaali": "^0.10.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-dropzone": "^14.2.3",
    "react-hook-form": "^7.48.2",
    "react-router-dom": "^6.20.1",
    "react-scripts": "5.0.1",
    "styled-components": "^6.1.6",
    "web-vitals": "^3.5.0"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^6.1.5",
    "@testing-library/react": "^13.4.0",
    "@testing-library/user-event": "^14.5.1",
    "electron": "^27.1.3",
    "electron-builder": "^24.6.4",
    "electron-dev-tools-installer": "^3.2.0",
    "wait-on": "^7.2.0"
  },
  "browserslist": {
    "production": [
      ">0.2%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  },
  "build": {
    "appId": "com.endoscopy.report.system",
    "productName": "Endoscopy Report System",
    "directories": {
      "output": "dist"
    },
    "files": [
      "build/**/*",
      "public/electron.js",
      "node_modules/**/*"
    ],
    "mac": {
      "category": "public.app-category.medical",
      "target": "dmg"
    },
    "win": {
      "target": "nsis"
    },
    "linux": {
      "target": "AppImage"
    }
  }
}




